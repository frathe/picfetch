+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	if err := largeInvalid.layout(1 << 20); !errors.Is(err, ErrInvalid) {
+		t.Fatalf("large invalid layout: %v, want ErrInvalid", err)
+	}
+	runtime.ReadMemStats(&after)
