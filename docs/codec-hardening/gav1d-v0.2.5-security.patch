+func TestGridFrameSizeLimit(t *testing.T) {
+	data, err := os.ReadFile("testdata/grid-2x2.avif")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Decode(bytes.NewReader(data), Options{FrameSizeLimit: 32_768}); err == nil {
+		t.Fatal("320x240 grid decoded under a 32,768 pixel limit")
+	}
+	if _, err := Decode(bytes.NewReader(data), Options{FrameSizeLimit: 76_800}); err != nil {
+		t.Fatalf("grid at exact limit: %v", err)
+	}
+}
