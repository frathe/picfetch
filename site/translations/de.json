    "features.sorting.body": {
      "source_hash": "a852d270b2e219e500cf18b327b421ca1c4ecb8fc1458e2a3992c7ab7e62d7c8",
      "request_hash": "efc7829dcdf367aabd24f12abffb54975012cd1042c948ad358299eb28e94125",
      "format": "html",
      "text": "\u003cp\u003eStandardmäßig natürliche Namensreihenfolge, daher \u003ccode\u003eIMG_2\u003c/code\u003e steht vor \u003ccode\u003eIMG_10\u003c/code\u003e. „\u003ckbd\u003eS\u003c/kbd\u003e“ wechselt zwischen Aufnahmedatum, Änderungszeitpunkt, Größe und der ursprünglichen Reihenfolge der Drop-Dateien hin und her.\u003c/p\u003e"
    },
    "features.sorting.title": {
      "source_hash": "907c9bd38f93aa31697ea19e8683021d7474748b8c9559ae785938ba8a8889df",
      "request_hash": "907c9bd38f93aa31697ea19e8683021d7474748b8c9559ae785938ba8a8889df",
      "format": "text",
      "text": "Sortieren, das Sinn macht"
    },
    "features.thumbnail-grid.body": {
      "source_hash": "40b27a2f03d0caa998af90a80d5f3cf8c6efd30e0f6a89b6b61b474c5a38ef51",
      "request_hash": "0a007206e64218cb0b5d59aad390a736baa51c8c82b8b427a75aca7b1846aee5",
      "format": "html",
      "text": "\u003cp\u003e\u003ckbd\u003eG\u003c/kbd\u003e Öffnet ein Vollbild-Raster, mit dem sich Bilder anhand ihres Aussehens finden lassen. Die Miniaturansichten werden nach und nach geladen, sodass auch ein Ordner mit mehreren tausend Dateien reaktionsschnell bleibt.\u003c/p\u003e"
    },
    "features.thumbnail-grid.title": {
      "source_hash": "303a2002a80977b665ecee678ddfd6ac9d7a17de971d1a3bef9fb33ec52b17a9",
