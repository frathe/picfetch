    "metadata.description": {
      "source_hash": "fe597bc1b5d7162f4583ca5d5bc1aa22dec0d910a59edba3f4aa6bee9794759a",
      "request_hash": "98319cc4bc63809923a4ffba74ff7d4cf326df7c77ad2899adee8fea7bd6c25c",
      "format": "text",
      "text": "PicFetch ist eine kleine, plattformübergreifende Desktop-Anwendung zum schnellen Anzeigen und Durchsuchen von Bildern. Ziehen Sie ein oder mehrere Bilder in das Fenster und blättern Sie mit der Tastatur durch sie hindurch."
    },
    "metadata.open-graph-description": {
      "source_hash": "b492cdcab51b43850e43d389daea58ca65a0ab27db04c6dfdfc2fa9c6b566255",
      "request_hash": "51bb3a48b0c07246a360f0ac8c746fac01a446abc668f6cb49c9a1b44e9f975c",
      "format": "text",
      "text": "Ziehen Sie ein oder mehrere Bilder in das Fenster und blättern Sie mit der Tastatur durch sie hindurch. Kostenlos und Open Source, für macOS, Windows und Linux."
    },
    "metadata.open-graph-title": {
      "source_hash": "da26b80749f014eb7a84d377a81416f685a78addc5d8d01623eb7e3f53011ab5",
      "request_hash": "6bcf0babaaa240195c90df80bf135ab31e3378735310195fb08f352b6ef742b1",
      "format": "text",
      "text": "PicFetch — ein kleiner, schneller Bildbetrachter"
    },
    "metadata.title": {
      "source_hash": "76d391b339e5b719cb36ea92ce34b65a65532025ec8793cdf3fe7f15c91dd883",
      "request_hash": "2404d488ad4346ec41eebbdbfa85f671608304769eba9c3040bd5b9db51cd06a",
      "format": "text",
      "text": "PicFetch — ein kleiner, schneller Bildbetrachter für macOS, Windows und Linux"
    },
    "screenshots.gallery.alt": {
      "source_hash": "9c4fdc5d42ecc62aac880ef615222bc28c8a1bc2ee2d9e52064f831eb9cd8a37",
      "request_hash": "9c4fdc5d42ecc62aac880ef615222bc28c8a1bc2ee2d9e52064f831eb9cd8a37",
      "format": "text",
      "text": "Miniaturansicht im Rasterformat, in der Dutzende von Fotos gleichzeitig angezeigt werden, wobei das aktuelle Bild hervorgehoben ist"
    },
    "screenshots.gallery.caption": {
      "source_hash": "9f33d84ac53d2216182ae4330c08ae3528b7ac0010367d30f34772f00f1a6dff",
      "request_hash": "9f33d84ac53d2216182ae4330c08ae3528b7ac0010367d30f34772f00f1a6dff",
      "format": "text",
      "text": "Das Miniaturbild-Raster zum Auffinden eines Bildes anhand des Aussehens"
    },
    "screenshots.main.alt": {
      "source_hash": "473f375ae7d362f4528e3728609a012be026b0e3a11dd7b1ed6b8b4a3b008c1b",
      "request_hash": "c7941924ab53b0d0391fe9bcd9793a8535369fffb8a2ccd1b84f55733410b07c",
      "format": "text",
      "text": "Das Hauptfenster von PicFetch mit der Aufforderung „Bilder hier ablegen“, bevor Bilder geladen werden"
    },
    "screenshots.main.caption": {
      "source_hash": "8f34cf88ac0819b0517045aadb8be2e8b45dcd7cb02abe3114f7e31425aedd84",
      "request_hash": "8f34cf88ac0819b0517045aadb8be2e8b45dcd7cb02abe3114f7e31425aedd84",
      "format": "text",
      "text": "Zieh Bilder in das Fenster, um loszulegen"
    },
    "screenshots.viewer.alt": {
      "source_hash": "46c5af32c5e6bb138b86fef8017842badf128705e861dfc5e96b111d4f7906d1",
      "request_hash": "180a58bf9e4d4441a270fdc77a0bf91b9a2cecd9951643abd8574675ff6ac97b",
      "format": "text",
      "text": "Ein vergrößertes Foto mit eingeblendeten Dateiinformationen und dem geöffneten Datenfenster „EXIF“, das Kamera, Blende, Brennweite und Aufnahmedatum anzeigt"
    },
    "screenshots.viewer.caption": {
      "source_hash": "553d74b600607d0700e226f577469a7f63f8bbd471b1523b1b861430a83af989",
      "request_hash": "a7d7a2a5b2390d465d43c09ff639b8b3ef19aa56e894e050465b2617eaa0da93",
      "format": "text",
      "text": "Vergrößerte Ansicht mit angezeigten Dateiinformationen und „EXIF“-Daten"
    },
