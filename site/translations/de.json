    "metadata.description": {
      "source_hash": "60aff229614699ffd4ace48a875936c656b9ec84cda613ce64cb858089efc067",
      "request_hash": "cac2baeeb223e3b0f03ce6bd860cac57b03d76bfc330f333e036ab8c96b6fe8a",
      "format": "text",
      "text": "Durchsuchen, vergleichen und entdecken Sie Ihre Fotos neu mit „PicFetch“. Entdecken Sie Orte auf „GPS“, finden Sie ähnliche Bilder in Ihrer Umgebung und erstellen Sie Fotomosaike. Kostenlos und als Open Source verfügbar unter macOS, Windows und Linux."
    },
    "metadata.open-graph-description": {
      "source_hash": "0310a8bc2dd0d98140ee167e65aae9da1aa2b24b967efbb217c490edcda23ecf",
      "request_hash": "165670fb528175a788e0e3db907fd738971c23dc8deeaf6065fd1791128c4a5c",
      "format": "text",
      "text": "Entdecken Sie Ihre Fotos nach Ort oder visueller Ähnlichkeit, vergleichen Sie Bilder und erstellen Sie Mosaike. Kostenlos und Open Source, für macOS, Windows und Linux."
    },
    "metadata.open-graph-title": {
      "source_hash": "da26b80749f014eb7a84d377a81416f685a78addc5d8d01623eb7e3f53011ab5",
      "request_hash": "6bcf0babaaa240195c90df80bf135ab31e3378735310195fb08f352b6ef742b1",
      "format": "text",
      "text": "PicFetch — ein kleiner, schneller Bildbetrachter"
    },
    "metadata.title": {
      "source_hash": "76d391b339e5b719cb36ea92ce34b65a65532025ec8793cdf3fe7f15c91dd883",
      "request_hash": "2404d488ad4346ec41eebbdbfa85f671608304769eba9c3040bd5b9db51cd06a",
      "format": "text",
      "text": "PicFetch — ein kleiner, schneller Bildbetrachter für macOS, Windows und Linux"
    },
    "screenshots.gallery.alt": {
      "source_hash": "9c4fdc5d42ecc62aac880ef615222bc28c8a1bc2ee2d9e52064f831eb9cd8a37",
      "request_hash": "9c4fdc5d42ecc62aac880ef615222bc28c8a1bc2ee2d9e52064f831eb9cd8a37",
      "format": "text",
      "text": "Miniaturansicht im Rasterformat, in der Dutzende von Fotos gleichzeitig angezeigt werden, wobei das aktuelle Bild hervorgehoben ist"
    },
    "screenshots.gallery.caption": {
      "source_hash": "9f33d84ac53d2216182ae4330c08ae3528b7ac0010367d30f34772f00f1a6dff",
      "request_hash": "9f33d84ac53d2216182ae4330c08ae3528b7ac0010367d30f34772f00f1a6dff",
      "format": "text",
      "text": "Das Miniaturbild-Raster zum Auffinden eines Bildes anhand des Aussehens"
    },
    "screenshots.location-map.alt": {
      "source_hash": "d09524dde0cb49f10413413b784a751831d6bd48d5236d8b1f7cc0aa315934d1",
      "request_hash": "c2f9dad63a8ef2817245d097a1d94f2f2fc672eb90fbe362d8c08d200801bfcf",
      "format": "text",
      "text": "Standortkarte von PicFetch mit Foto-Miniaturansichten und nummerierten Gruppen in ganz Europa, mit den Steuerelementen „Alles anpassen“ und „Zurück zum Viewer“"
    },
    "screenshots.location-map.caption": {
      "source_hash": "0016825be579696498ee1cd2f894b2a8a89e435c56f5835e2e8d1c125dea7ac2",
      "request_hash": "d73079640f26f114fe3b1c696b73da4291443b9af0d2b51090a29daef10c03ed",
      "format": "text",
      "text": "Fotos mit dem Tag „GPS“ nach Ort durchsuchen – mit Ortskarte"
    },
    "screenshots.main.alt": {
      "source_hash": "473f375ae7d362f4528e3728609a012be026b0e3a11dd7b1ed6b8b4a3b008c1b",
      "request_hash": "c7941924ab53b0d0391fe9bcd9793a8535369fffb8a2ccd1b84f55733410b07c",
      "format": "text",
      "text": "Das Hauptfenster von PicFetch mit der Aufforderung „Bilder hier ablegen“, bevor Bilder geladen werden"
    },
    "screenshots.main.caption": {
      "source_hash": "8f34cf88ac0819b0517045aadb8be2e8b45dcd7cb02abe3114f7e31425aedd84",
      "request_hash": "8f34cf88ac0819b0517045aadb8be2e8b45dcd7cb02abe3114f7e31425aedd84",
      "format": "text",
      "text": "Zieh Bilder in das Fenster, um loszulegen"
    },
    "screenshots.mosaic-creation.alt": {
      "source_hash": "fd442997d6707c083f549d73fb08b9e48ddc8e9e9d0b1d477cabac04cd17230e",
      "request_hash": "fd442997d6707c083f549d73fb08b9e48ddc8e9e9d0b1d477cabac04cd17230e",
      "format": "text",
      "text": "Ein generiertes Bildmosaik aus überlappenden, gerahmten Reisefotos, mit Funktionen zum Neuerstellen, Speichern oder Festlegen als Hintergrundbild"
    },
    "screenshots.mosaic-creation.caption": {
      "source_hash": "bd8e45f026df50f7e82378764fd4c2f50c8109f0ffbe0b28e90e4a45afead52d",
      "request_hash": "bd8e45f026df50f7e82378764fd4c2f50c8109f0ffbe0b28e90e4a45afead52d",
      "format": "text",
      "text": "Erstellen Sie ein Mosaik in Bildschirmgröße, speichern Sie es anschließend oder legen Sie es als Hintergrundbild fest"
    },
    "screenshots.mosaic-settings.alt": {
      "source_hash": "7971cb1b35262133f81f0b7fe743e7db20c84c28434e3dd45cdd7d6bac162482",
      "request_hash": "7971cb1b35262133f81f0b7fe743e7db20c84c28434e3dd45cdd7d6bac162482",
      "format": "text",
      "text": "Das Einstellungsfenster „Bildmosaik“ mit einer Auswahl von 403 Bildern, einer Zielanzeigeauswahl sowie erweiterten Steuerelementen für Bildgröße, Rahmen, Größenvariation, Überlappung, Drehung und Schlagschatten"
    },
    "screenshots.mosaic-settings.caption": {
      "source_hash": "1730c4df202df90d77c8ee9bb8bd530252141a7c89de470fd072b51b4e285c35",
      "request_hash": "1730c4df202df90d77c8ee9bb8bd530252141a7c89de470fd072b51b4e285c35",
      "format": "text",
      "text": "Wählen Sie eine Anzeige aus und passen Sie das Erscheinungsbild des Mosaiks an"
    },
    "screenshots.side-by-side.alt": {
      "source_hash": "98ea75e3b555fbce739d759d315ecabfd10225e2d0c4c52daf159dd118980c90",
      "request_hash": "d022d65a3815256be510563aca4a0fa7d3a821c01baebda15a899ef8b8bab0b9",
      "format": "text",
      "text": "Zwei nebeneinander angezeigte Fotos in „PicFetch“, um Details zu vergleichen"
    },
    "screenshots.side-by-side.caption": {
      "source_hash": "b7bedcd35f1a8e3d4e17f232392b57fdfa7b3451b7f267bff89efed7a36a2356",
      "request_hash": "b7bedcd35f1a8e3d4e17f232392b57fdfa7b3451b7f267bff89efed7a36a2356",
      "format": "text",
      "text": "Zwei Fotos nebeneinander vergleichen – mit verknüpftem Zoomen und Verschieben"
    },
    "screenshots.similarity-explorer.alt": {
      "source_hash": "a29db90bbe619642d296f3f8500b932de8f5d873604c991715dd29540e9bba65",
      "request_hash": "a29db90bbe619642d296f3f8500b932de8f5d873604c991715dd29540e9bba65",
      "format": "text",
      "text": "Der „Similarity Explorer“ zeigt Stapel verwandter Fotos, Themenfilter und eine Detailstufensteuerung zur Anpassung der Gruppierung an"
    },
    "screenshots.similarity-explorer.caption": {
      "source_hash": "dd71ba545792282453dfa592806c24161a3d8e97f389e012066f7429c8e81f36",
      "request_hash": "dd71ba545792282453dfa592806c24161a3d8e97f389e012066f7429c8e81f36",
      "format": "text",
      "text": "Entdecken Sie ähnliche Fotos im Similarity Explorer"
    },
    "screenshots.swipe-compare.alt": {
      "source_hash": "a3e49d9a7a73fca6cf22c122d83222e5b56bfa0a96ece2eec65c6845cbdda759",
      "request_hash": "6dd898acdb912b173ca3fd10d1483e0e29f5f58b2baa24c63549b33ada4f39ba",
      "format": "text",
      "text": "Zwei Fotos, die in „PicFetch“ übereinandergelegt wurden, mit einem verschiebbaren Trennbalken, der die Unterschiede sichtbar macht"
    },
    "screenshots.swipe-compare.caption": {
      "source_hash": "36ff90db9316863a5c61d684045bd41cc1d3c6f3485ca6c032f2afd4a20ad631",
      "request_hash": "36ff90db9316863a5c61d684045bd41cc1d3c6f3485ca6c032f2afd4a20ad631",
      "format": "text",
      "text": "Schieben Sie den Teiler, um die Unterschiede zwischen den Bildern zu erkennen"
    },
    "screenshots.viewer.alt": {
      "source_hash": "4b7a91c0c3b2b79fe3567f09ff47b3df4173b4c465ab1ce9bda77f8a6a4726e1",
      "request_hash": "fae055ea2b04f7fdc18f00580d524df70177b1ecba2ed67c6546c59790423387",
      "format": "text",
      "text": "Ein Foto mit geöffnetem Datenfenster von „EXIF“, das die Kameraeinstellungen, das Aufnahmedatum und eine Ansicht des aufgezeichneten Standorts unter OpenStreetMap GPS zeigt"
    },
    "screenshots.viewer.caption": {
      "source_hash": "96ac0dc4801a6b63a106ddf82c76d2b94ad00987c5c364ec0c626b8ec72b08b0",
      "request_hash": "4786f4861f261c5ad7dd71570887096754020f89277090cfec0b0cdb01c4e725",
      "format": "text",
      "text": "Überprüfen Sie die Kameraeinstellungen und den Aufnahmestandort des Fotos"
