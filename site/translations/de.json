    "hero.image-alt": {
      "source_hash": "2f39d1e2c662234ac3d9f517790b0be5b9a29d60498c02b5e12b42c7cdfaf376",
      "request_hash": "73ebb625840f679ba98e3016fc989bfb51a675325d2e2afdc1e7f138ea4818e3",
      "format": "text",
      "text": "PicFetch — das App-Fenster, in dem neben der Maskottchen-Grafik die Aufforderung „Bilder hier ablegen“ angezeigt wird"
    },
    "hero.tagline": {
      "source_hash": "8b3e7f011f84661eb03f38d04ef3b2b8eb1638c3ed0b3f8c636fec53594d4ce9",
      "request_hash": "632a9dd54a1c88017b6d4f0ba896db3303a084b5a53c0c33cc1e5d5c77a9f06f",
      "format": "html",
      "text": "\u003cp\u003eEine kleine Desktop-App zum schnellen Anzeigen und Durchblättern von Bildern. Ziehen Sie ein oder mehrere Bilder in das Fenster und blättern Sie mit der Tastatur durch die Bilderserie.\u003c/p\u003e"
    },
